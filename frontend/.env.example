# Mapbox Tokens
# You need 2 different tokens:
#
# 1. MAPBOX_ACCESS_TOKEN (pk.eyJ...) - Public token for the app to display maps
#    Get from: https://account.mapbox.com/access-tokens/
#    Free tier: 50,000 map loads/month
#
# 2. MAPBOX_DOWNLOADS_TOKEN (sk.eyJ...) - Secret token for Gradle/Maven downloads
#    Get from: https://account.mapbox.com/access-tokens/
#    This is used by Gradle to download Mapbox SDK dependencies
#    Set this in App_Resources/Android/gradle.properties (or use sync script)

MAPBOX_ACCESS_TOKEN=your_public_token_here
MAPBOX_DOWNLOADS_TOKEN=your_secret_token_here
